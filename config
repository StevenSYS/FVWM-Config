# Options
read options

infoStoreAdd baseColor #8080FF

# `24` is the height of the top panel.
ewmhBaseStruts screen $[monitor.primary] 0 0 24 0

# Default font
defaultFont "xft:Sans:bold:size=8:antialias=true"

# Colorset
colorset 1 fg #FFFFFF, bg #000000
colorset 2 \
	fg $[fg.cs99], \
	bg $[bg.cs99], \
	hi $[hilight.cs99], \
	sh $[shadow.cs99]

colorset 3 \
	fg $[fg.cs99], \
	bg $[bg.cs99.darken25], \
	hi $[hilight.cs99.darken25], \
	sh $[shadow.cs99.darken25]

# Style
style * \
	mouseFocusClickRaises, \
	clickToFocus, \
	borderWidth 5, \
	handleWidth 5, \
	colorset 3, \
	hilightcolorset 2, \
	edgeMoveDelay 90, \
	edgeMoveResistance 90, \
	snapAttraction 8 windows

opaqueMoveSize unlimited

style topPanel \
	!title, \
	!borders, \
	!handles, \
	sticky, \
	windowListSkip, \
	neverFocus

style ConfirmQuit \
	!title, \
	positionPlacement center, \
	windowListSkip, \
	layer 6

style audacious \
	!title, \
	!borders, \
	!handles, \
	layer 6

titleStyle centered height 24
titleStyle activeDown -- flat
titleStyle inactive -- flat

buttonStyle all vector 2 0x0@5 0x0@5
buttonStyle all toggledInactive -- flat
buttonStyle all inactive -- flat

addButtonStyle 2 active tiledPixmap closeActive.png
addButtonStyle 2 toggledActive tiledPixmap closeActive.png
addButtonStyle 2 inactive tiledPixmap closeInactive.png
addButtonStyle 2 toggledInactive tiledPixmap closeInactive.png

menuStyle * \
	menuColorset 3, \
	activeColorset 2, \
	greyedColorset 3, \
	titleColorset 2, \
	hilightBack, \
	hilight3DOff, \
	hilightTitleBack, \
	separatorsLong, \
	!automaticHotKeys \

# Functions
destroyFunc startFunction
addToFunc startFunction
+ i module FvwmButtons topPanel
+ i module FvwmMFL
+ i test ($[infostore.enablePicom]) \
	exec picom

destroyFunc initFunction
addToFunc initFunction
+ i module FvwmIconMan
+ i exec ~/.fehbg

destroyFunc exitFunction
addToFunc exitFunction
+ i test ($[infostore.enablePicom]) \
	exec killall picom

destroyFunc raiseMove
addToFunc raiseMove
+ i raise
+ m $0

destroyFunc raiseMoveDC
addToFunc raiseMoveDC
+ i raise
+ m $0
+ d $1

# Taken from the default config file.
destroyFunc moveDir
addToFunc moveDir
+ i move shuffle layers $[w.layer] $[w.layer] snap windows $0
+ i warpToWindow 50 50

# Menus
destroyMenu menuFvwmRoot
addToMenu menuFvwmRoot "FVWM Menu" title
+ "$[gt.&Change Wallpaper]" exec ~/.fvwm/prg_wallpaperSelect
+ "" none 
+ "$[gt.&Restart FVWM]" restart
+ "$[gt.&Quit FVWM]" module FvwmScript FvwmScript-ConfirmQuit

destroyMenu menuWindow
addToMenu menuWindow
+ "$[gt.&Always On Top]" pick (circulateHit) layer 0 6
+ "$[gt.&Disable Always On Top]" pick (circulateHit) layer 0 4

# Modules
destroyModuleConfig topPanel:*
*topPanel: geometry $[monitor.$[monitor.primary].width]x24-0+0@p
*topPanel: colorset 1
*topPanel: rows 24
*topPanel: columns $[montior.$[monitor.primary].width]
*topPanel: frame 0
*topPanel: ( \
	$[monitor.$[monitor.primary].width]x24, \
	frame 0, \
	swallow FvwmApplet-DigitalClock "FvwmScript digitalClock 1" \
)
test ($[infostore.laptop]) \
	*topPanel: ( \
		128x24, \
		frame 0, \
		swallow FvwmApplet-BatteryInfo "FvwmScript batteryInfo 1" \
	)

# Keyboard binds
silent key Tab A M \
	windowList root c c \
	noDeskSort, \
	noGeometry, \
	selectOnRelease meta_l, \
	currentAtEnd

silent key F4 A M \
	close root c c \
	noDeskSort, \
	noGeometry, \
	selectOnRelease meta_l, \
	currentAtEnd

# Keyboard shortcuts
key Up WTSF CM moveDir up
key Down WTSF CM moveDir down
key Left WTSF CM moveDir left
key Right WTSF CM moveDir right

read keyShortcuts

# Mouse binds
mouse 3 T A menu menuWindow
mouse 1 2 A close
mouse 1 T A raiseMoveDC move maximize
mouse 1 FS A raiseMove resize