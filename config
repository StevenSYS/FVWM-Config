Read options

DesktopConfiguration per-monitor 

# This is to fix screen tearing
exec exec picom

# Start Function
DestroyFunc StartFunction
AddToFunc StartFunction
+ I Module FvwmButtons TopPanel
+ I Module FvwmEvent EventNewDesk
+ I Exec ~/.fehbg

# Mouse Bindings Functions
DestroyFunc RaiseMoveX
AddToFunc RaiseMoveX
+ I Raise
+ M $0
+ D $1

DestroyFunc RaiseMove
AddToFunc RaiseMove
+ I Raise
+ M $0

DestroyFunc MoveToCurrent
AddToFunc MoveToCurrent
+ I ThisWindow MoveToPage
+ I ThisWindow MoveToDesk

DestroyFunc ToggleTitle
AddToFunc   ToggleTitle
+ I ThisWindow (HasTitle) WindowStyle !Title
+ I TestRc (NoMatch) WindowStyle Title

# Desktops and Pages
DesktopName 0 Main
DesktopSize 1x1

EdgeScroll 100 100
EdgeResistance 451
EdgeThickness 1
Style * EdgeMoveDelay 90, EdgeMoveResistance 90

EwmhBaseStruts screen $[monitor.primary] 0 0 24 0

ClickTime 250
MoveThreshold 3

Style * MouseFocusClickRaises, ClickToFocus

# Default Font
DefaultFont "xft:Sans:Bold:size=8:antialias=True"

# Window Placement
Style * MinOverlapPlacement, GrabFocusOff, !UsePPosition

OpaqueMoveSize unlimited
Style * SnapAttraction 8 Windows

Style * DecorateTransient, StackTransientParent
Style * !FPGrabFocusTransient, FPReleaseFocusTransient

IgnoreModifiers L25

# Decor Styles
Style * BorderWidth 5, HandleWidth 5, MWMButtons, FvwmBorder, FirmBorder
Style * Colorset 1, HilightColorset 2

Style * BorderColorset 3 4 3 4 3 4 3 4
Style * HilightBorderColorset 4 8 4 8 4 8 4 8

Style * !Icon
Style * Lenience

# Window Specific Styles
Style TopPanel !Title, !Borders, !Handles, Sticky, \
                 WindowListSkip, NeverFocus
Style ConfirmQuit !Title, PositionPlacement Center, WindowListSkip, Layer 6
Style FvwmIdent WindowListSkip
Style audacious !Title, !Borders, !Handles, Layer 6

Read $[FVWM_USERDIR]/colorSchemes/$[infostore.colorScheme]

MenuStyle * MenuColorset 5, ActiveColorset 6, GreyedColorset 7, TitleColorset 8
MenuStyle * Hilight3DOff, HilightBack, HilightTitleBack, SeparatorsLong
MenuStyle * TrianglesSolid, TrianglesUseFore
MenuStyle * ItemFormat "%s%|%3.1i%5.3l%5l%5r%5.3>%|"
MenuStyle * Font "xft:Sans:Bold:size=8:antialias=True"

# Root Menu
DestroyMenu MenuFvwmRoot
AddToMenu   MenuFvwmRoot "Root Menu" Title
+ "$[gt.&Change Wallpaper]"                Exec exec ~/.fvwm/wallpaperSelect
+ ""                                       None
+ "$[gt.Re&fresh]%icons/refresh.png%"      Refresh
+ "$[gt.&Restart FVWM]%icons/restart.png%" Restart
+ "$[gt.&Log Out]%icons/quit.png%"         Module FvwmScript FvwmScript-ConfirmQuit

# Window Operations Menus
DestroyMenu MenuWindowOps
AddToMenu   MenuWindowOps
+ "$[gt.Stays On Top]%icons/win/top.png%"       Pick (CirculateHit) Layer 0 6
+ "$[gt.Stays Put]%icons/win/stays.png%"        Pick (CirculateHit) Layer 0 4

Silent Key Tab A M WindowList Root c c NoDeskSort, NoGeometry, SelectOnRelease Meta_L, CurrentAtEnd
Silent Key F4 A M Close Root c c NoDeskSort, NoGeometry, SelectOnRelease Meta_L, CurrentAtEnd
Silent Key T A C1 Exec exec $[infostore.terminal]
Silent Key Escape A C Exec rofi -modi "drun,calc" -show drun

# Backlight Brightness
Silent Key Prior A S1 Exec exec brightnessctl set 1%+
Silent Key Next A S1 Exec exec brightnessctl set 1%-

Silent Key Home A S1 Exec exec brightnessctl set 100%
Silent Key End A S1 Exec exec brightnessctl set $[infostore.minBrightness]

# Sound Volume
Silent Key Prior A C1 Exec exec pactl set-sink-volume @DEFAULT_SINK@ +5%
Silent Key Next A C1 Exec exec pactl set-sink-volume @DEFAULT_SINK@ -5%

Silent Key Prior A C1S Exec exec pactl set-sink-volume @DEFAULT_SINK@ +1%
Silent Key Next A C1S Exec exec pactl set-sink-volume @DEFAULT_SINK@ -1%

Silent Key End A C1 Exec exec pactl set-sink-mute @DEFAULT_SINK@ toggle

# Touchpad Toggle
Silent Key Home A CS Exec exec xinput enable $[infostore.touchpadId] 
Silent Key End A CS Exec exec xinput disable $[infostore.touchpadId]

# Screenshot
Silent Key Print A A Exec exec $[infostore.screenshot] --interactive

# DECtalk
# Silent Key F A M Exec exec $[infostore.decTalkPath]/say.sh READSELECTED
# Silent Key G A M Exec exec $[infostore.decTalkPath]/stop.sh

# Shuffle moves a window in a given direction until it hits another window.
# These bindings will shuffle a window using the arrow keys.
#    Ctrl-Alt Up_Arrow     - Shuffle window up
#    Ctrl-Alt Right_Arrow  - Shuffle window right
#    Ctrl-Alt Down_Arrow   - Shuffle window down
#    Ctrl-Alt Left_Arrow   - Shuffle window left
DestroyFunc ShuffleDir
AddToFunc   ShuffleDir
+ I Move shuffle layers $[w.layer] $[w.layer] snap windows $0
+ I WarpToWindow 50 50

Key Up      WTSF    CM  ShuffleDir up
Key Down    WTSF    CM  ShuffleDir down
Key Left    WTSF    CM  ShuffleDir left
Key Right   WTSF    CM  ShuffleDir right

Mouse 1 2 A Close

Mouse 3 T    A Menu MenuWindowOps
Mouse 1 T    A RaiseMoveX Move Maximize
Mouse 1 FS   A RaiseMove Resize

TitleStyle Centered Height 24
TitleStyle ActiveDown -- Flat
TitleStyle Inactive -- Flat

ButtonStyle All Vector 2 0x0@5 0x0@5
ButtonStyle All ToggledInactive -- Flat
ButtonStyle All Inactive -- Flat

AddButtonStyle 2 Inactive TiledPixmap closeInactive.png
AddButtonStyle 2 Active TiledPixmap closeActive.png
AddButtonStyle 2 ToggledInactive TiledPixmap closeInactive.png
AddButtonStyle 2 ToggledActive TiledPixmap closeActive.png

# FvwmIdent
DestroyModuleConfig FvwmIdent:*
*FvwmIdent: Colorset 10
*FvwmIdent: Font "xft:Sans:size=10:antialias=True"

# FvwmScript
DestroyModuleConfig FvwmScript:*
*FvwmScript: DefaultColorset 10

# FvwmButtons - TopPanel
DestroyModuleConfig TopPanel:*
*TopPanel: Geometry $[monitor.$[monitor.primary].width]x24-0+0@p
*TopPanel: Colorset 10
*TopPanel: Rows 24
*TopPanel: Columns $[monitor.$[monitor.primary].width]
*TopPanel: Frame 0
*TopPanel: Font "xft:Sans:Bold:size=10:antialias=True"
*TopPanel: ($[monitor.$[monitor.primary].width]x24, Frame 0, Swallow FvwmApplet-DigitalClock "FvwmScript /home/steven/.fvwm/digitalClock")
Test (x stalonetray) *TopPanel: (120x24, Swallow(NoClose,UseOld) \
    stalonetray 'Exec exec stalonetray --config \
    "$[FVWM_DATADIR]/default-config/stalonetrayrc"', Frame 0)
*TopPanel: (128x24, Frame 0, Swallow FvwmApplet-BatteryInfo "FvwmScript /home/steven/.fvwm/batteryInfo")

# FvwmEvent
DestroyModuleConfig EventNewDesk:*
*EventNewDesk: PassID
*EventNewDesk: new_desk ChangeDesk