WindowTitle {FvwmApplet-BatteryInfo}
WindowSize 128 32
Font "xft:Sans:size=10:antialias=True"

Init
Begin
	Set $title = (GetOutput {exec ~/.fvwm/prg_batteryInfo} 1 -1)
	ChangeTitle 1 $title
End

PeriodicTasks
Begin
	If (RemainderOfDiv (GetTime) 30) == 0 Then
	Begin
		Set $title = (GetOutput {exec ~/.fvwm/prg_batteryInfo} 1 -1)
		ChangeTitle 1 $title
	End
End

Widget 1
Property
	Position 0 -3
	Size 128 32
	Type ItemDraw
	Flags NoReliefString
	Title {}
Main
	Case message of
		SingleClic:
		Begin
		End
End