# Color Scheme

# Original:
# colorset 99 fg #FFFFFF, bg #404040, hi #505050, sh #202020
colorset 99 fg #FFFFFF, bg #404040, hi #505050, sh #202020

# Variables

# Variables - Programs
infoStoreAdd terminal TERMINAL-PROGRAM-GOES-HERE
